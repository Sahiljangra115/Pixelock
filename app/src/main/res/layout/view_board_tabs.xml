<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginBottom="12dp">

    <TextView android:id="@+id/today" style="@style/Tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/board_today" android:textColor="@color/tile_text" />
    <TextView android:id="@+id/week" style="@style/Tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:text="@string/board_week" android:textColor="@color/tile_text" />
    <TextView android:id="@+id/month" style="@style/Tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/board_month" android:textColor="@color/tile_text" />
</LinearLayout>
