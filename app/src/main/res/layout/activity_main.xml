<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page">

    <LinearLayout
        android:id="@+id/shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:id="@+id/blocks_pill"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@color/digit_idle" />

                <TextView
                    android:id="@+id/blocks_count"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0" />
            </LinearLayout>

            <dev.pixelock.app.ui.views.PixelLogoView
                android:id="@+id/logo"
                android:layout_width="150dp"
                android:layout_height="26dp"
                android:layout_gravity="center" />

            <ImageButton
                android:id="@+id/settings_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_pill"
                android:contentDescription="@string/open_settings"
                android:src="@drawable/ic_gear" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="10dp"
            android:background="@drawable/bg_nav"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <ImageButton android:id="@+id/nav_timer" style="@style/NavButton" android:contentDescription="@string/tab_timer" android:src="@drawable/ic_timer" />
            <ImageButton android:id="@+id/nav_bags" style="@style/NavButton" android:contentDescription="@string/tab_bags" android:src="@drawable/ic_bag" />
            <ImageButton android:id="@+id/nav_routines" style="@style/NavButton" android:contentDescription="@string/tab_routines" android:src="@drawable/ic_grid" />
            <ImageButton android:id="@+id/nav_stats" style="@style/NavButton" android:contentDescription="@string/tab_stats" android:src="@drawable/ic_bars" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />
</FrameLayout>
