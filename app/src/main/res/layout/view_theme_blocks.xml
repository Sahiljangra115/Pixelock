<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_marginBottom="8dp">

    <LinearLayout android:id="@+id/theme_system" style="@style/Slot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="1">
        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_swatch_system" />
        <TextView style="@style/Text.Label" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/theme_system" android:textColor="@color/tile_text" />
    </LinearLayout>

    <LinearLayout android:id="@+id/theme_light" style="@style/Slot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="1">
        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_swatch_light" />
        <TextView style="@style/Text.Label" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/theme_light" android:textColor="@color/tile_text" />
    </LinearLayout>

    <LinearLayout android:id="@+id/theme_dark" style="@style/Slot" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <View android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_swatch_dark" />
        <TextView style="@style/Text.Label" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/theme_dark" android:textColor="@color/tile_text" />
    </LinearLayout>
</LinearLayout>
