<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@drawable/bg_card">

        <dev.pixelock.app.ui.views.TowerStripView
            android:id="@+id/towers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="28dp"
            android:paddingVertical="26dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/caption"
        style="@style/Text.Caps"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:drawableEnd="@drawable/ic_chevron_right"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/bg_outline"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/prev"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stats_prev"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/period"
            style="@style/Text.Caps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/next"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stats_next"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="3">

        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView android:id="@+id/mode_day" style="@style/Tile" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="@string/stats_day" android:textColor="@color/tile_text" />
            <TextView android:id="@+id/mode_month" style="@style/Tile" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginVertical="8dp" android:layout_weight="1" android:text="@string/stats_month" android:textColor="@color/tile_text" />
            <TextView android:id="@+id/mode_year" style="@style/Tile" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="@string/stats_year" android:textColor="@color/tile_text" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_group">

            <dev.pixelock.app.ui.views.DialView
                android:id="@+id/dial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="12dp"
                android:contentDescription="@string/stats_dial" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
