<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@drawable/bg_card">

        <dev.pixelock.app.ui.views.PixelClockView
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp" />

        <TextView
            android:id="@+id/warning"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/service_off_warning"
            android:textColor="@color/digit"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="5">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.2"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3">

                <LinearLayout android:id="@+id/preset_15" style="@style/Tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="1">
                    <TextView style="@style/Text.Value" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15" android:textColor="@color/tile_text" />
                    <TextView style="@style/Text.Label" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/minutes" android:textColor="@color/tile_sub" />
                </LinearLayout>

                <LinearLayout android:id="@+id/preset_45" style="@style/Tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                    <TextView style="@style/Text.Value" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45" android:textColor="@color/tile_text" />
                    <TextView style="@style/Text.Label" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/minutes" android:textColor="@color/tile_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="4">

                <LinearLayout android:id="@+id/preset_180" style="@style/Tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="8dp" android:layout_weight="1">
                    <TextView style="@style/Text.Value" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="@color/tile_text" />
                    <TextView style="@style/Text.Label" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hours" android:textColor="@color/tile_sub" />
                </LinearLayout>

                <LinearLayout android:id="@+id/preset_custom" style="@style/Tile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                    <TextView android:id="@+id/custom_value" style="@style/Text.Value" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12:00" android:textColor="@color/tile_text" />
                    <TextView style="@style/Text.Label" android:duplicateParentState="true" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/custom" android:textColor="@color/tile_sub" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <dev.pixelock.app.ui.views.RulerView
                android:id="@+id/ruler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline"
                android:contentDescription="@string/time_slider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_outline"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/step_up"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/time_more"
                    android:src="@drawable/ic_chevron_up" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tile_line" />

                <ImageButton
                    android:id="@+id/step_down"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/time_less"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/running_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pause"
            style="@style/Tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="2"
            android:textColor="@color/tile_text" />

        <TextView
            android:id="@+id/add_time"
            style="@style/Tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textColor="@color/tile_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/pay_end"
        style="@style/Tile"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="@string/pay_end_timer"
        android:textColor="@color/tile_text"
        android:visibility="gone" />

    <dev.pixelock.app.ui.views.SlideView
        android:id="@+id/slide"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp" />
</LinearLayout>
